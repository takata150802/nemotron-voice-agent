# Copy to .env. Model downloads happen during setup only.
PLATFORM=cpu
EXAMPLE_SELECTION=generic-assistant
TRANSPORT_SELECTION=webrtc
PROMPT_SELECTOR=cpu_japanese
ENABLE_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
CUDA_VISIBLE_DEVICES=-1
USE_SILERO_VAD_TURN_DETECTION=true
SILERO_VAD_STOP_SECS=0.5
PIPELINE_TLS=true
UVICORN_WORKERS=1
AUDIO_OUT_10MS_CHUNKS=5

NEMO_SPEECH_URL=ws://127.0.0.1:8081/v1/realtime
NEMO_ASR_MODEL=
NEMO_ASR_LANGUAGE=ja-JP
NEMO_ASR_PREROLL_MS=800
NEMO_ASR_THREADS=2
NEMO_HTTP_THREADS=4
NEMO_SPEECH_BIN=.build/NeMo-Speech.cpp/build/cpu-server/bin/nemo-speech

LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=gpt-oss-20b
LLM_MODEL_PATH=
LLAMA_THREADS=4
LLAMA_THREADS_BATCH=4
LLAMA_CTX_SIZE=4096
LLAMA_BIN=.build/llama.cpp/build/bin/llama-server

TTS_PROVIDER=voicevox
TTS_BASE_URL=http://127.0.0.1:50021
TTS_VOICE_ID=3
TTS_THREADS=2
VOICEVOX_BIN=
VOICE_AGENT_HOST=0.0.0.0
VOICE_AGENT_PORT=7860
# Trusted TLS certificate files for your LAN server name/IP.
VOICE_AGENT_TLS_CERT=
VOICE_AGENT_TLS_KEY=
