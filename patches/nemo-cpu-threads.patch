 namespace ggml_runtime {
 
+// Local fork control: upstream fixes scheduler compute to four threads.
+// Use the ggml backend's existing thread-setting API for every compute path.
+static int cpu_threads() {
+    const char* value = std::getenv("NEMO_ASR_THREADS");
+    if (!value) return 4;
+    char* end = nullptr;
+    const long count = std::strtol(value, &end, 10);
+    if (*end || count < 1 || count > 256)
+        throw std::runtime_error("NEMO_ASR_THREADS must be between 1 and 256");
+    return static_cast<int>(count);
+}
+
 Session::~Session() = default;
 
